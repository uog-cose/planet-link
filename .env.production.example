# Copy to .env.production on the Droplet. Never commit .env.production.
APP_ENV=prod
APP_NAME=Youth Quest
DEBUG=false
ENABLE_QUICK_LOGIN=false
SECRET_KEY=

# Domain and HTTPS (Caddy obtains and renews the certificate automatically).
DOMAIN=
ACME_EMAIL=
ALLOWED_HOSTS=
CORS_ORIGINS=
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=
PUBLIC_APP_URL=

API_PREFIX=api
API_URL=/api
ENABLE_PWA=true
SECURE_COOKIES=true
SESSION_COOKIE_AGE=604800
RATE_LIMIT_BACKEND=locmem

# PostgreSQL runs privately in Docker on the same Droplet.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
SEED_DEMO=false

# Optional: leave blank to disable browser push notifications initially.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto: