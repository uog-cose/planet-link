# Single source of environment configuration for local/dev/prod.
APP_ENV=local
APP_NAME=Youth Quest
DEBUG=true
ENABLE_QUICK_LOGIN=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,backend,.devtunnels.ms
CORS_ORIGINS=http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5174,https://*.devtunnels.ms
API_PREFIX=api
API_URL=/api
ENABLE_PWA=true
PUBLIC_APP_URL=http://localhost:5174
SECURE_COOKIES=false
SESSION_COOKIE_AGE=604800
RATE_LIMIT_BACKEND=locmem
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_FORWARD_PORT=
APP_DATA_DIR=
BACKEND_PORT=8001
FRONTEND_PORT=5174
FRONTEND_URL=http://localhost:5174
SEED_DEMO=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
OS_PLACES_API_KEY=
